<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BgBaseBrush" Color="#FF14161A" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="#FF1B1E24" />
    <SolidColorBrush x:Key="BgPanel2Brush" Color="#FF20242C" />
    <SolidColorBrush x:Key="BgCellBrush" Color="#FF242833" />
    <SolidColorBrush x:Key="BgCellBeatBrush" Color="#FF2A2F3C" />
    <SolidColorBrush x:Key="LineBrush" Color="#FF2C3038" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#FF3D434E" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE8E6E1" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF7A8290" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF4D5360" />
    <SolidColorBrush x:Key="AccentDrumBrush" Color="#FFE8935A" />
    <SolidColorBrush x:Key="AccentBassBrush" Color="#FF5AA9E6" />
    <SolidColorBrush x:Key="AccentKeysBrush" Color="#FFB586E8" />
    <SolidColorBrush x:Key="AccentKeysDimBrush" Color="#FF3F3350" />
    <SolidColorBrush x:Key="AccentLoopBrush" Color="#FF6FD6A8" />
    <SolidColorBrush x:Key="AccentLoopDimBrush" Color="#FF274235" />

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BgBaseBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="LabelSmall" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="GroupBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgPanel2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="0,4,10,4" />
    </Style>

    <!-- 丸ボタン（Play/Stop/Loop等）。見た目の切り替えはコードビハインドでBackground/Foregroundを直接設定 -->
    <Style x:Key="TransportButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{StaticResource BgPanel2Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StepperButton" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="{StaticResource BgBaseBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Background" Value="{StaticResource BgPanel2Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- タブ／小節タブ／音色カード／ステップセル共通の「フラットな角丸ボタン」。
         状態による色分けはすべてコードビハインドで Background/BorderBrush を直接設定する -->
    <Style x:Key="FlatToggleButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgPanel2Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MuteToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Background" Value="{StaticResource BgBaseBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
